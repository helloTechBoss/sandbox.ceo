generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Locale {
  tc
  en
  sc
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  CONVERTED
  CLOSED
}

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

model Page {
  id        String    @id @default(cuid())
  slug      String    @unique
  sections  Section[]
  seo       SeoMeta?
  updatedAt DateTime  @updatedAt
}

model Section {
  id           String  @id @default(cuid())
  page         Page    @relation(fields: [pageId], references: [id])
  pageId       String
  key          String
  subTab       String?
  translations Json
  order        Int     @default(0)

  @@unique([pageId, key])
  @@index([pageId, subTab])
}

model SeoMeta {
  id          String  @id @default(cuid())
  page        Page    @relation(fields: [pageId], references: [id])
  pageId      String  @unique
  title       Json
  description Json
  keywords    Json
  ogImage     String?
}

model Article {
  id                 String    @id @default(cuid())
  slug               String    @unique
  category           Json
  categoryColor      String?
  title              Json
  excerpt            Json
  body               Json?
  ctaLabel           Json
  ctaWhatsappMessage String?
  publishedAt        DateTime?
  published          Boolean   @default(false)
  order              Int       @default(0)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

model Package {
  id                 String             @id @default(cuid())
  group              String
  tierLabel          String
  name               Json
  price              String
  stripeAmount       Int?               // HKD, null = enquiry only (not directly purchasable)
  priceNote          Json?
  featured           Boolean            @default(false)
  badgeLabel         Json?
  ctaWhatsappMessage String?
  order              Int                @default(0)
  features           PackageFeature[]
}

model PackageFeature {
  id        String  @id @default(cuid())
  package   Package @relation(fields: [packageId], references: [id], onDelete: Cascade)
  packageId String
  label     Json
  enabled   Boolean @default(true)
  order     Int     @default(0)
}

model Faq {
  id       String  @id @default(cuid())
  pageSlug String
  subTab   String?
  question Json
  answer   Json
  order    Int     @default(0)

  @@index([pageSlug, subTab])
}

model TeamMember {
  id       String  @id @default(cuid())
  name     Json
  title    Json
  bio      Json?
  photoUrl String?
  order    Int     @default(0)
  active   Boolean @default(true)
}

model Lead {
  id              String     @id @default(cuid())
  name            String
  email           String?
  phone           String?
  serviceInterest String?
  message         String?
  sourcePage      String?
  sourceLocale    Locale?
  status          LeadStatus @default(NEW)
  notes           String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  role         String   @default("editor")
  createdAt    DateTime @default(now())
}

model ServiceOrder {
  id              String             @id @default(cuid())
  stripeSessionId String             @unique
  totalAmount     Int                // HKD
  status          String             @default("pending_onboarding")
  member          Member?            @relation(fields: [memberId], references: [id])
  memberId        String?
  items           ServiceOrderItem[]
  onboarding      ClientOnboarding?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([status])
  @@index([memberId])
}

model ServiceOrderItem {
  id       String       @id @default(cuid())
  order    ServiceOrder @relation(fields: [orderId], references: [id])
  orderId  String
  itemType String       // 'package' | 'cpt'
  itemId   String       // Package.id or CptCourse.id (snapshot only, no FK)
  name     Json         // {tc, en, sc} snapshot at time of purchase
  amount   Int          // HKD paid
}

model ClientOnboarding {
  id          String       @id @default(cuid())
  order       ServiceOrder @relation(fields: [orderId], references: [id])
  orderId     String       @unique
  fullName    String
  email       String
  phone       String?
  companyName String?
  companyBrNo String?
  hkidNo      String?
  notes       String?
  docs        ClientDoc[]
  submittedAt DateTime     @default(now())

  @@index([email])
}

model ClientDoc {
  id             String           @id @default(cuid())
  onboarding     ClientOnboarding @relation(fields: [onboardingId], references: [id], onDelete: Cascade)
  onboardingId   String
  docType        String           // 'hkid' | 'passport' | 'br' | 'bank_statement' | 'other'
  label          String
  url            String
  uploadedAt     DateTime         @default(now())
}

model CptCourse {
  id           String        @id @default(cuid())
  name         Json          // {tc, en, sc}
  description  Json          // {tc, en, sc}
  price        Int           // HKD in dollars (e.g. 880)
  videoUrl     String?       // Vimeo/YouTube embed URL or Blob URL
  thumbnailUrl String?
  published    Boolean       @default(false)
  featured     Boolean       @default(false)
  order        Int           @default(0)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  purchases    CptPurchase[]
}

model CptPurchase {
  id              String    @id @default(cuid())
  course          CptCourse @relation(fields: [courseId], references: [id])
  courseId        String
  email           String
  name            String?
  stripeSessionId String    @unique
  amountPaid      Int       // HKD
  paidAt          DateTime  @default(now())

  @@index([courseId])
  @@index([email])
}

model Member {
  id            String      @id @default(cuid())
  email         String      @unique
  phone         String?
  name          String
  emailVerified Boolean     @default(false)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  otps          MemberOtp[]
  orders        ServiceOrder[]

  @@index([email])
}

model MemberOtp {
  id        String   @id @default(cuid())
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  memberId  String
  code      String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([memberId])
}
